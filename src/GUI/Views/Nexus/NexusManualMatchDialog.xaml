<adonisControls:AdonisWindow x:Class="DivinityModManager.Views.Nexus.NexusManualMatchDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
	xmlns:local="clr-namespace:DivinityModManager.Views.Nexus"
	Title="Review Nexus Match"
	Width="760"
	Height="520"
	MinWidth="700"
	MinHeight="460"
	Background="{DynamicResource {x:Static adonisUI:Brushes.Layer0BackgroundBrush}}"
	TitleBarBackground="#4e38c9"
	TitleBarForeground="{DynamicResource {x:Static adonisUI:Brushes.AccentForegroundBrush}}"
	WindowStartupLocation="CenterOwner">
	<Window.Style>
		<Style BasedOn="{StaticResource {x:Type Window}}" TargetType="Window" />
	</Window.Style>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<TextBlock FontSize="16" FontWeight="Bold" Text="{Binding ModName, StringFormat=Review match for: {0}}" />

		<Grid Grid.Row="1" Margin="0,12,0,12">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<Border Padding="8" BorderBrush="{DynamicResource {x:Static adonisUI:Brushes.Layer1BorderBrush}}" BorderThickness="1">
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ListBox x:Name="CandidatesListBox" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}">
						<ListBox.ItemTemplate>
							<DataTemplate>
								<Border Margin="0,0,0,8" Padding="8" BorderBrush="{DynamicResource {x:Static adonisUI:Brushes.Layer1BorderBrush}}" BorderThickness="1">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock FontWeight="Bold" Text="{Binding Name}" />
											<TextBlock Text="{Binding Author, StringFormat=by {0}}" />
											<TextBlock Text="{Binding Version, StringFormat=Version: {0}}" />
											<TextBlock Text="{Binding Endorsements, StringFormat=Endorsements: {0}}" />
										</StackPanel>
										<TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Score, StringFormat=score {0:F2}}" />
									</Grid>
								</Border>
							</DataTemplate>
						</ListBox.ItemTemplate>
					</ListBox>
				</ScrollViewer>
			</Border>

			<TextBlock Grid.Row="1"
				Margin="0,8,0,0"
				Foreground="Goldenrod"
				Text="No matches found. You can set a Mod ID manually.">
				<TextBlock.Style>
					<Style TargetType="TextBlock">
						<Setter Property="Visibility" Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger Binding="{Binding HasCandidates}" Value="False">
								<Setter Property="Visibility" Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
		</Grid>

		<StackPanel Grid.Row="2">
			<StackPanel Orientation="Horizontal">
				<Button x:Name="UseMatchButton" MinWidth="140" Margin="0,0,8,0" Command="{Binding UseMatchCommand}" Content="Use this match" IsDefault="True" />
				<Button MinWidth="100" Margin="0,0,8,0" Command="{Binding SkipCommand}" Content="Skip" IsCancel="True" />
			</StackPanel>
			<Expander Margin="0,8,0,0" Header="More options ▸" IsExpanded="{Binding MoreOptionsExpanded}">
				<StackPanel Margin="8,4,0,0" Orientation="Horizontal">
					<Button Margin="0,0,8,0" Command="{Binding SetModIdCommand}" Content="Set Mod ID manually…" />
					<Button Command="{Binding MarkNotOnNexusCommand}" Content="Mark Not on Nexus" />
				</StackPanel>
			</Expander>
		</StackPanel>
	</Grid>
</adonisControls:AdonisWindow>
