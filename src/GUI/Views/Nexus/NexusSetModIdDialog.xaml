<adonisControls:AdonisWindow x:Class="DivinityModManager.Views.Nexus.NexusSetModIdDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
	xmlns:adonisUI="clr-namespace:AdonisUI;assembly=AdonisUI"
	Title="Set Nexus Mod ID"
	Width="560"
	Height="190"
	MinWidth="540"
	WindowStartupLocation="CenterOwner"
	Background="{DynamicResource {x:Static adonisUI:Brushes.Layer0BackgroundBrush}}"
	TitleBarBackground="#4e38c9"
	TitleBarForeground="{DynamicResource {x:Static adonisUI:Brushes.AccentForegroundBrush}}">
	<Window.Style>
		<Style BasedOn="{StaticResource {x:Type Window}}" TargetType="Window" />
	</Window.Style>
	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<TextBlock x:Name="PromptText" Text="Paste a Nexus Mod ID or full URL:" />
		<TextBox x:Name="InputTextBox" Grid.Row="1" Margin="0,8,0,0" MinWidth="460" />
		<StackPanel Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
			<TextBlock x:Name="ErrorText" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="IndianRed" />
			<Button Width="90" Margin="0,0,8,0" Click="OnOkClicked" Content="OK" IsDefault="True" />
			<Button Width="90" Click="OnCancelClicked" Content="Cancel" IsCancel="True" />
		</StackPanel>
	</Grid>
</adonisControls:AdonisWindow>
